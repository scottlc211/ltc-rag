# =====================================================================
#  生产环境配置模板（Docker Compose 部署到 VPS）
#
#  用法：
#    Copy-Item deploy\.env.prod.example deploy\.env.server
#    把 http(s) 地址、Key、密码改成真值，然后跑 scripts\deploy-remote.ps1
#
#  注意：deploy\.env.server 含明文密钥，已加入 .gitignore，不要提交。
#  docker compose 只有在名为 ".env" 的文件里才会自动读取变量替换，
#  所以 deploy-remote.ps1 上传时会把它改名成 <远端目录>/.env。
# =====================================================================

# ===== 数据库（服务名 mysql 即容器内主机名，不要改成 127.0.0.1）=====
MYSQL_ROOT_PASSWORD=换成20位以上强密码
MYSQL_DB=ltc_rag
# MYSQL_HOST/USER/PASSWORD 由 docker-compose.yml 固定成容器内网直连，这里不用填

# ===== 向量库（Qdrant 容器，只监听宿主机 127.0.0.1）=====
QDRANT_ENABLED=true
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ltc_chunks

# ===== Embedding：硅基流动免费额度，bge-m3 是 1024 维 =====
# 换模型必须同步改 EMBEDDING_DIMENSION，再调 /v1/documents/reindex 全量重建
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-填硅基流动的key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ===== Chat：DeepSeek =====
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_API_KEY=sk-填deepseek的key
CHAT_MODEL=deepseek-chat

# ===== Rerank：要额外花额度，先关；开了检索排序会更准 =====
RERANK_ENABLED=false
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 服务 =====
# 对外的应用端口；8080 已被占用时改这里（例如 8081）
APP_PORT=8080
# 小内存机用 Dockerfile.runtime（预构建 jar）；要源码构建改成 Dockerfile
APP_DOCKERFILE=Dockerfile.runtime
MAX_UPLOAD_MB=40
# 服务器上没有本地 OCR 服务，保持 false（传图片会返回 OCR_DISABLED 并提示先转 Markdown）
OCR_ENABLED=false
AUTH_ENABLED=true
